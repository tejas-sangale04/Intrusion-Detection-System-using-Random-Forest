# Data and generated artifacts stay out of Git (large, and re-creatable)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
models/*
!models/.gitkeep
reports/metrics/**/*.parquet

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.ipynb_checkpoints/

# Environment and editor
.env
.vscode/
.idea/
.DS_Store
Thumbs.db
